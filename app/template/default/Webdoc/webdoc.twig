{% block main %}

<h1>Webdoc 一覧</h1>
<a href="{{ path('webdoc_new') }}" class="btn btn-primary mb-3">新規追加</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>タイトル</th>
            <th>作成日</th>
            <th>更新日</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        {% for n in news %}
            <tr>
                <td>{{ n.id }}</td>
                <td>
                 {{ n.title }}
                </td>
                <td>{{ n.createDate|date('Y-m-d H:i') }}</td>
                <td>{{ n.updateDate|date('Y-m-d H:i') }}</td>
                <td>
                        
                        <a href="{{ path('webdoc_delete', {'id': n.id}) }}" class="btn btn-sm btn-danger">削除</a>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">データがありません。</td></tr>
        {% endfor %}
    </tbody>
</table>

{% endblock %}
